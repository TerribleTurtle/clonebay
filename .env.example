# ==========================================
# EVE Online SSO Configuration (Next.js App)
# ==========================================
# Required: Application Client ID from CCP Developer Portal (https://developers.eveonline.com)
NEXT_PUBLIC_EVE_CLIENT_ID=your_eve_client_id_here

# Optional: Custom OAuth callback URL (defaults to window.location.origin + /auth/callback if omitted)
NEXT_PUBLIC_EVE_CALLBACK_URL=https://your-domain.example.com/auth/callback

# ==========================================
# Developer Tooling (Optional)
# ==========================================
# Used only by scripts/oauth-scraper.ts (never exposed to browser client)
EVE_CLIENT_SECRET=your_eve_client_secret_here
