{
  "name": "clonebay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3006",
    "build": "next build",
    "start": "serve out",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test:core": "vitest run",
    "verify-mocks": "npx tsx scripts/verify-mocks.ts",
    "verify": "npm run type-check && npm run verify-mocks && npm run lint && npm run test:core && npm run deps:check",
    "deps:check": "depcruise src",
    "prepare": "husky",
    "playground": "npx tsx scripts/playground.ts",
    "deploy:prod": "npm run build && node scripts/fix-windows-build.mjs && npx wrangler pages deploy out --project-name clonebay --branch main"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.2.8",
    "idb-keyval": "6.2.5",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "swr": "2.4.1",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.0.0",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "4.1.8",
    "dependency-cruiser": "17.4.3",
    "dotenv": "17.4.2",
    "eslint": "9",
    "eslint-config-next": "16.2.7",
    "eslint-plugin-boundaries": "6.0.2",
    "eslint-plugin-functional": "10.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-promise": "7.3.0",
    "fake-indexeddb": "^6.2.5",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.0.7",
    "msw": "2.14.6",
    "postcss": "8.4.38",
    "serve": "14.2.4",
    "tailwindcss": "4",
    "typescript": "5",
    "vitest": "4.1.8"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  }
}
