# Static security headers for Cloudflare Pages.
#
# The Content-Security-Policy is NOT set here. scripts/csp-hashes.mjs runs after
# `next build` (npm postbuild), hashes every inline <script> in out/**/*.html, and
# appends per-route CSP rules to out/_headers.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=()
